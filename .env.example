# Copy this file to .env at the repo root and fill in real values before
# running `docker compose up`. .env is git-ignored — never commit real secrets.

# Required for the AI Coach chat, category suggestion, and scenario parsing
# features. If left empty, the rest of the app still works — only those
# AI-backed calls fail (mapped to HTTP 502 by src/api/main.py).
ANTHROPIC_API_KEY=

# Optional: email notifications for bills due soon, budget overruns, and
# critical/high recommendations. If SMTP_HOST/NOTIFICATION_TO_EMAIL are left
# empty, the periodic check still runs but skips sending (logs and returns
# early) instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
NOTIFICATION_CHECK_INTERVAL_MINUTES=60

# Required for auth: signs JWT access tokens issued at POST /auth/login.
# Generate a real value in production, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
# Left at the default below, the API works but tokens are NOT secure.
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
# Access tokens are short-lived on purpose -- POST /auth/refresh silently
# renews the session using the longer-lived refresh token below, so this no
# longer needs to cover a whole day the way it did before refresh tokens
# existed.
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Login lockout: after this many failed attempts for a given username within
# the window, further attempts are rejected with 429 until the window passes.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# How long a POST /auth/forgot-password reset link stays valid before it
# must be requested again.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Forgot-password lockout: after this many reset requests for a given email
# within the window, further requests are rejected with 429. Tighter than
# login's lockout since spamming reset emails at an address is lower-
# frequency but higher-annoyance-per-hit than login brute-forcing.
PASSWORD_RESET_LOCKOUT_MAX_ATTEMPTS=3
PASSWORD_RESET_LOCKOUT_WINDOW_MINUTES=60

# Origin used to build links in emails (e.g. the password reset link). Must
# match wherever the frontend is actually reachable -- localhost only works
# for testing from the same machine as the backend.
FRONTEND_BASE_URL=http://localhost:5173
