# Copy this file to .env at the repo root and fill in real values before
# running `docker compose up`. .env is git-ignored — never commit real secrets.

# Required for the AI Coach chat, category suggestion, and scenario parsing
# features. If left empty, the rest of the app still works — only those
# AI-backed calls fail (mapped to HTTP 502 by src/api/main.py).
ANTHROPIC_API_KEY=

# Optional: email notifications for bills due soon, budget overruns, and
# critical/high recommendations. If SMTP_HOST/NOTIFICATION_TO_EMAIL are left
# empty, the periodic check still runs but skips sending (logs and returns
# early) instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
NOTIFICATION_CHECK_INTERVAL_MINUTES=60
