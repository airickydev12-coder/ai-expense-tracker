# Copy this file to .env at the repo root and fill in real values before
# running `docker compose up`. .env is git-ignored — never commit real secrets.

# Required for the AI Coach chat, category suggestion, and scenario parsing
# features. If left empty, the rest of the app still works — only those
# AI-backed calls fail (mapped to HTTP 502 by src/api/main.py).
ANTHROPIC_API_KEY=

# Optional: email notifications for bills due soon, budget overruns, and
# critical/high recommendations -- also used for the email-verification
# link sent on registration/resend and the password-reset link. If
# SMTP_HOST/NOTIFICATION_TO_EMAIL are left empty, the periodic notification
# check skips sending instead of failing; registration still succeeds even
# without SMTP configured (verification is soft, never blocks login), but
# an explicit POST /auth/resend-verification will surface a real 502.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
NOTIFICATION_CHECK_INTERVAL_MINUTES=60

# development (default) or production. In production, the app refuses to
# start at all if JWT_SECRET_KEY is still the insecure default below --
# in development it only logs a warning. Doesn't affect anything else.
ENVIRONMENT=development

# Required for auth: signs JWT access tokens issued at POST /auth/login.
# Generate a real value in production, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
# Left at the default below, the API works but tokens are NOT secure --
# and won't even start with ENVIRONMENT=production.
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
# Access tokens are short-lived on purpose -- POST /auth/refresh silently
# renews the session using the longer-lived refresh token below, so this no
# longer needs to cover a whole day the way it did before refresh tokens
# existed.
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# The refresh token is stored in an HttpOnly cookie, never in JavaScript-
# readable storage. Set this to true once this deployment is actually
# served over HTTPS -- browsers silently refuse to set a Secure cookie over
# plain HTTP at all, so flipping this on before TLS exists breaks login.
COOKIE_SECURE=false

# Login lockout: after this many failed attempts for a given username within
# the window, further attempts are rejected with 429 until the window passes.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# How long a POST /auth/forgot-password reset link stays valid before it
# must be requested again.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Forgot-password lockout: after this many reset requests for a given email
# within the window, further requests are rejected with 429. Tighter than
# login's lockout since spamming reset emails at an address is lower-
# frequency but higher-annoyance-per-hit than login brute-forcing.
PASSWORD_RESET_LOCKOUT_MAX_ATTEMPTS=3
PASSWORD_RESET_LOCKOUT_WINDOW_MINUTES=60

# Origin used to build links in emails (e.g. the password reset link). Must
# match wherever the frontend is actually reachable -- localhost only works
# for testing from the same machine as the backend.
FRONTEND_BASE_URL=http://localhost:5173

# How long a verification link (sent on registration or resend) stays valid.
# Longer than the password-reset window above since verification is
# non-urgent -- it never blocks login or feature access.
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=1440

# Resend-verification lockout: after this many resend requests for the
# authenticated user within the window, further requests are rejected with
# 429. Same shape as the password-reset lockout above, scoped by user_id
# instead of email since resend is an authenticated action.
EMAIL_VERIFICATION_RESEND_LOCKOUT_MAX_ATTEMPTS=3
EMAIL_VERIFICATION_RESEND_LOCKOUT_WINDOW_MINUTES=60

# How long an access token's auth_time (last real password verification) is
# considered "recent enough" for step-up-gated actions (revoking all
# sessions, admin role changes, admin activate/deactivate) before the caller
# must re-authenticate via POST /auth/reauth.
STEP_UP_MAX_AGE_MINUTES=10
