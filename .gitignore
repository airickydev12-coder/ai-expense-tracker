# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Pytest
.pytest_cache/

# Environment files
.env
.env.*

# The env template is a placeholder with no real values — safe to commit
!.env.example

# VS Code
.vscode/

# JetBrains
.idea/

# Temporary test and coverage files
.pytest_temp/
.coverage
htmlcov/

# Application logs
logs/

# Frontend (Node/Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local

# Frontend dev env default is safe to commit (no secrets) — override the blanket .env.* rule above
!frontend/.env.development

# Frontend production env is also safe to commit (no secrets, just the
# nginx-proxied relative API base) — same override pattern as .development
!frontend/.env.production
